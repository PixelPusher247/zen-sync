{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zen Sync",
  "version": "0.2.0",
  "identifier": "app.zen.zensync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "beforeDevCommand": "npm run vite:dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zen Sync",
        "width": 400,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MjAyRUMwODFBODFDRjUKUldUMUhLaUJ3QzRnZUVCMUZtZTgwQ09kb0NLd3NhZUNid0I4K1hWTmd2bEIyUlp4Wm83Zkk1eHUK",
      "endpoints": [
        "https://github.com/PixelPusher247/zen-sync/releases/latest/download/latest.json"
      ]
    }
  }
}
